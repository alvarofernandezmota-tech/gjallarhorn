# Copia este fichero a `.env` (está en el .gitignore: nunca se sube) y rellena.
# El servicio systemd y `make` lo leen solos.

# Avisos al móvil por Telegram. El bot lo crea @BotFather; tu chat te lo dice
# @userinfobot. Sin estas dos, las citas y recados se quedan en avisos.json.
GJALLARHORN_TELEGRAM_TOKEN=
GJALLARHORN_TELEGRAM_CHAT=
# Qué se manda. Por defecto: cita,llamada,fallo (las tarifas son ruido).
# GJALLARHORN_TELEGRAM_TIPOS=cita,llamada,fallo

# Dónde guardar avisos y agenda. Sin esto, en datos/ dentro del repo.
# GJALLARHORN_DATOS=/ruta/fuera/del/repo
