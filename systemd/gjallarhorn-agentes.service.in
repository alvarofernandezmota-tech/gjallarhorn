# Plantilla: `make agentes-diarios` la rellena y la deja en ~/.config/systemd/user/.
[Unit]
Description=gjallarhorn: los agentes de cada mañana (recordatorios, resumen, revisión)

[Service]
Type=oneshot
WorkingDirectory=@RAIZ@
# Los agentes dejan avisos; `avisar` los manda al móvil si hay Telegram puesto.
ExecStart=/bin/sh -c '@PYTHON@ -m dueno.agentes --negocio @NEGOCIO@ && @PYTHON@ -m dueno.avisar --negocio @NEGOCIO@ || true'
